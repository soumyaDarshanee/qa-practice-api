# Copy to .env to override the defaults in docker-compose.yml
POSTGRES_DB=compliance
POSTGRES_USER=compliance
POSTGRES_PASSWORD=compliance
DEBUG=true
# Turns on /api/e2e/ (reset, seed-status, user factory). Test-only.
E2E_MODE=true
SECRET_KEY=dev-only-not-a-secret
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
